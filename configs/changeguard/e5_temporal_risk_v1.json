  "risk_signals_specification": {
    "primary_temporal_null_risk": {
      "signal_name": "s_null",
      "formula": "0.5 * sum_{z in {pre2/pre2, post/post}} max(0, mean_valid p_cand(flood|z) - mean_valid p_src(flood|z))",
      "input_pairs": ["pre2/pre2", "post/post"],
      "predeclared_risk_direction": "higher_is_greater_risk",
      "zero_valid_handling": "unavailable_null",
      "serialized_field": "s_null"
    },
    "secondary_source_referenced_flood_change": {
      "expansion_signal": {
        "signal_name": "s_flood_expansion",
        "formula": "mean_valid max(0, p_cand(flood) - p_src(flood))",
        "input_pair": "pre2/post",
        "predeclared_risk_direction": "higher_indicates_greater_flood_surge",
        "zero_valid_handling": "unavailable_null",
        "serialized_field": "s_flood_expansion"
      },
      "disappearance_signal": {
        "signal_name": "s_flood_disappearance",
        "formula": "mean_valid max(0, p_src(flood) - p_cand(flood))",
        "input_pair": "pre2/post",
        "predeclared_risk_direction": "higher_indicates_greater_flood_erasure",
        "zero_valid_handling": "unavailable_null",
        "serialized_field": "s_flood_disappearance"
      }
    },
    "generic_risk_evidence": [
      {
        "signal_name": "mean_entropy",
        "formula": "- 1/N sum_i sum_c p_cand,c log(p_cand,c + eps)",
        "input_pair": "pre2/post",
        "serialized_field": "mean_entropy"
      },
      {
        "signal_name": "mean_max_confidence",
        "formula": "1/N sum_i max_c p_cand,c",
        "input_pair": "pre2/post",
        "serialized_field": "mean_max_confidence"
      },
      {
        "signal_name": "source_to_candidate_kl",
        "formula": "1/N sum_i sum_c p_cand,c log((p_cand,c + eps) / (p_src,c + eps))",
        "input_pair": "pre2/post",
        "predeclared_direction": "cand_relative_to_src",
        "serialized_field": "source_to_candidate_kl"
      },
      {
        "signal_name": "hard_disagreement_rate",
        "formula": "mean_valid (argmax(p_cand) != argmax(p_src))",
        "input_pair": "pre2/post",
        "serialized_field": "hard_disagreement_rate"
      },
      {
        "signal_name": "delta_flood_pixels",
        "formula": "count(pred_cand == 2) - count(pred_src == 2)",
        "input_pair": "pre2/post",
        "serialized_field": "delta_flood_pixels"
      },
      {
        "signal_name": "abs_delta_flood_pixels",
        "formula": "|delta_flood_pixels|",
        "input_pair": "pre2/post",
        "serialized_field": "abs_delta_flood_pixels"
      },
      {
        "signal_name": "aug_inconsistency",
        "formula": "0.5 * mean_valid sum_c |p_weak,c - p_strong_aligned,c|",
        "input_pair": "pre2/post",
        "serialized_field": "aug_inconsistency"
      },
      {
        "signal_name": "bn_weight_displacement",
        "formula": "||w_cand - w_src||_2",
        "serialized_field": "bn_weight_displacement"
      },
      {
        "signal_name": "bn_bias_displacement",
        "formula": "||b_cand - b_src||_2",
        "serialized_field": "bn_bias_displacement"
      }
    ]
  },
