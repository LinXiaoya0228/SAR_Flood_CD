{
  "$schema_version": "1.0.0",
  "status": "AWAITING_USER_APPROVAL",
  "model_name": "snunet_vvvh_slope_controlled",
  "configuration_id": "model_b_topographic_ablation",
  "description": "Controlled 3-channel SNUNet source ablation using dual-polarization Sentinel-1 GRD SAR (VV, VH) concatenated with normalized terrain slope.",
  "task": "change_detection",
  "architecture": {
    "name": "SNUNet_ECAM",
    "base_channel": 32,
    "in_channels_per_branch": 3,
    "out_channels": 3
  },
  "input_specification": {
    "temporal_branches": ["pre_event_2", "post_event"],
    "channels_per_branch": ["vv", "vh", "slope"],
    "patch_size": [224, 224],
    "sar_clamping": {
      "min": 0.0,
      "max": 0.15
    },
    "sar_normalization": {
      "mean": [0.0953, 0.0264],
      "std": [0.0427, 0.0215]
    },
    "nan_treatment": {
      "nan": 0.15,
      "posinf": 0.15,
      "neginf": 0.0
    },
    "slope_specification": {
      "source_dem_raster": "MK0_DEM",
      "algorithm": "richdem_slope_riserun",
      "dem_nodata_threshold": -1000.0,
      "pixel_spacing_meters": 10.0,
      "normalization_note": "Awaiting user approval on empirical slope statistics versus unit-grid scaling"
    }
  },
  "label_specification": {
    "num_classes": 3,
    "label_mapping": {
      "0": "no_water",
      "1": "permanent_water",
      "2": "flood_water",
      "3": "invalid_no_data"
    },
    "ignore_index": 3,
    "valid_mask_rule": "valid = (valid_mask == 1) & (label != 3)"
  },
  "training_protocol": {
    "optimizer": "adam",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "betas": [0.9, 0.999],
    "batch_size": 32,
    "num_workers": 4,
    "mixed_precision": true,
    "proposed_epochs": 150,
    "early_stopping_patience": 20,
    "loss_function": "cross_entropy_plus_dice",
    "seeds": [42, 43, 44]
  },
  "data_split": {
    "split_proposal_path": "configs/splits/kuro_source_inner_split_proposed.json",
    "source_inner_train_event_count": 22,
    "source_inner_val_event_count": 5
  },
  "checkpoint_and_logging": {
    "output_dir": "outputs/source_models/snunet_vvvh_slope",
    "save_best_metric": "macro_f1",
    "completeness_tracking": true,
    "resume_supported": true
  },
  "unresolved_fields_requiring_approval": {
    "slope_normalization_statistics": "PENDING_APPROVAL (upstream mean=2.1277, std=67.5048 vs robust dataset recalculation)",
    "loss_class_weighting": "PENDING_APPROVAL (uniform [1,1,1] vs inverse-frequency [0.37, 14.0, 8.2])",
    "formal_training_epochs": "PENDING_APPROVAL (proposed 150 vs early stopping threshold)"
  }
}
