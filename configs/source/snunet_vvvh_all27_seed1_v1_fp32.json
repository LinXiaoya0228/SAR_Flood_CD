    "sar_preprocessing_order": [
      "1. clamp raw linear amplitude to [sar_clamp_min, sar_clamp_max]",
      "2. replace non-finite values (NaN, +Inf, -Inf) with nan_replacement_value",
      "3. z-score normalize using (sar - mean) / std"
