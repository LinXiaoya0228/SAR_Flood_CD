{
  "$schema_version": "1.0.0",
  "status": "WEEK0_FROZEN_PENDING_WEEK1_SMOKE",
  "approval_date": "2026-10-06",
  "model_name": "snunet_vvvh_controlled",
  "configuration_id": "model_a_radar_only_v1",
  "description": "Controlled 2-channel SNUNet source baseline using dual-polarization Sentinel-1 GRD SAR (VV, VH) without auxiliary topographic channels. Approved and frozen at Week 0 closeout.",
  "task": "change_detection",
  "run_type": "source_training",
  "architecture": {
    "name": "SNUNet_ECAM",
    "base_channel": 32,
    "in_channels_per_branch": 2,
    "out_channels": 3
  },
  "input_specification": {
    "temporal_branches": ["pre_event_2", "post_event"],
    "channels_per_branch": ["vv", "vh"],
    "patch_size": [224, 224],
    "sar_preprocessing_order": [
      "1. clamp raw linear amplitude to [sar_clamp_min, sar_clamp_max]",
      "2. replace non-finite values (NaN, +Inf, -Inf) with nan_replacement_value",
      "3. z-score normalize using (sar - mean) / std"
    ],
    "sar_clamping": {
      "min": 0.0,
      "max": 0.15
    },
    "nan_treatment": {
      "nan": 0.15,
      "posinf": 0.15,
      "neginf": 0.0
    },
    "sar_normalization": {
      "mean": [0.0953, 0.0264],
      "std": [0.0427, 0.0215]
    }
  },
  "label_specification": {
    "num_classes": 3,
    "label_mapping": {
      "0": "no_water",
      "1": "permanent_water",
      "2": "flood_water",
      "3": "invalid_no_data"
    },
    "ignore_index": 3,
    "valid_mask_rule": "valid = (valid_mask == 1) & (label != 3)",
    "evaluation_classes": {
      "target_class": 2,
      "background_classes": [0, 1],
      "excluded_class": 3
    }
  },
  "loss_specification": {
    "name": "unweighted_ce_plus_soft_dice",
    "weight_ce": 0.5,
    "weight_dice": 0.5,
    "classes_in_dice": [0, 1, 2],
    "ignore_index": 3,
    "smooth_epsilon": 1.0,
    "class_weighting": "unweighted_1_1_1",
    "formula": "total_loss = 0.5 * cross_entropy(logits, target, ignore_index=3) + 0.5 * mean_soft_dice_loss(softmax(logits), target, classes=[0,1,2], ignore_index=3, eps=1.0)",
    "absent_class_handling": "Smooth Dice with eps=1.0 ensures denominator is strictly positive and numerator equals eps when ground truth has zero pixels for class c, producing stable zero loss for correct absence and smooth bounded gradients for false alarms."
  },
  "optimization_protocol": {
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "betas": [0.9, 0.999],
    "lr_scheduler": null,
    "mixed_precision": true,
    "max_epochs": 150,
    "early_stopping_patience": 20,
    "seeds": [42, 43, 44]
  },
  "batch_size_policy": {
    "effective_batch_size": 32,
    "physical_microbatch_size": 8,
    "gradient_accumulation_steps": 4,
    "physical_microbatch_status": "CONFIRMED_LOCKED",
    "candidate_microbatches_for_smoke_test": [2, 4, 8, 16],
    "divisibility_requirement": "effective_batch_size % physical_microbatch_size == 0",
    "accumulation_loss_semantics": "Gradient accumulation gives an effective optimization batch of 32, but the Soft Dice denominator is evaluated per physical microbatch of 8. The measured difference from a full-batch Dice calculation was approximately 0.36% in the controlled equivalence test."
  },
  "data_split": {
    "split_config_path": "configs/splits/kuro_source_inner_split_v1.json",
    "split_config_sha256": "7afd9768da9f37031a93a3aa813e3cd9812a110ee463e1c9442998b0f3e486d3",
    "source_inner_train_event_count": 22,
    "source_inner_val_event_count": 5,
    "sample_policy": "all_source_inner_train_patches_retained_no_filtering_no_oversampling"
  },
  "model_selection_metrics": {
    "primary_selection_metric": "event_macro_flood_f1",
    "secondary_selection_metrics": [
      "worst_event_flood_f1",
      "event_macro_flood_recall",
      "event_macro_flood_iou",
      "pooled_flood_f1"
    ],
    "deterministic_epoch_tie_breaking": [
      "1. higher event_macro_flood_f1",
      "2. higher worst_event_flood_f1",
      "3. higher event_macro_flood_recall",
      "4. earlier epoch (smaller integer)"
    ]
  },
  "final_retraining_rule": {
    "retraining_corpus": "all_27_source_events",
    "total_samples": 21462,
    "retraining_epochs_formula": "E_final = median(best_epoch_seed42, best_epoch_seed43, best_epoch_seed44)",
    "validation_tuning_during_retraining": "strictly_prohibited_zero_val_tuning"
  },
  "execution_guards": {
    "ready_for_formal_training": false,
    "ready_for_week1_smoke_test": true,
    "launch_block_reason": "Physical microbatch size must be confirmed by Week 1 memory smoke test and recorded in a versioned protocol amendment before formal multi-epoch training.",
    "smoke_test_preset": {
      "smoke_microbatch_size": 2,
      "smoke_epochs": 1,
      "smoke_batches_per_epoch": 2,
      "smoke_gpu_target": 0
    }
  }
}
